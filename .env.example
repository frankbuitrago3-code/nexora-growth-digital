# Obligatorio para el envío real de formularios.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
LEADS_TO_EMAIL=

# Alternativa de contacto pública; se muestra solo si se configura.
NEXT_PUBLIC_CONTACT_EMAIL=

# Dominio canónico; usa http://localhost:3000 solo en desarrollo local.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Opcionales. No se carga medición hasta que la persona acepte cookies.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_ID=
